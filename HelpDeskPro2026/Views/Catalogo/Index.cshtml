@{
    ViewData["Title"] = "Catálogos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>
                <i class="bi bi-folder-fill text-warning"></i>
                Catálogos
            </h2>

            <p class="text-muted">
                Seleccione el catálogo que desea administrar.
            </p>

        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-primary">

            <i class="bi bi-house-door-fill"></i>

            Inicio

        </a>

    </div>

    <div class="row">

        <div class="col-md-6 col-lg-4 mb-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <i class="bi bi-pc-display display-3 text-primary"></i>

                    <h4 class="mt-3">

                        Sistemas

                    </h4>

                    <p class="text-muted">

                        Administración de los sistemas registrados.

                    </p>

                </div>

                <div class="card-footer bg-white border-0 text-center mb-3">

                    <a asp-controller="Sistema"
                       asp-action="Index"
                       class="btn btn-primary">

                        <i class="bi bi-arrow-right-circle"></i>

                        Abrir

                    </a>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-lg-4 mb-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <i class="bi bi-tags-fill display-3 text-warning"></i>

                    <h4 class="mt-3">
                        Categorías
                    </h4>

                    <p class="text-muted">
                        Administre las categorías de incidencias y solicitudes.
                    </p>

                </div>

                <div class="card-footer bg-white border-0 text-center mb-3">

                    <a asp-controller="Categoria"
                       asp-action="Index"
                       class="btn btn-warning text-dark">

                        <i class="bi bi-arrow-right-circle"></i>

                        Abrir

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-4 mb-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <i class="bi bi-exclamation-triangle-fill display-3 text-danger"></i>

                    <h4 class="mt-3">
                        Riesgos
                    </h4>

                    <p class="text-muted">
                        Administre los niveles de riesgo del sistema.
                    </p>

                </div>

                <div class="card-footer bg-white border-0 text-center mb-3">

                    <a asp-controller="Riesgo"
                       asp-action="Index"
                       class="btn btn-danger">

                        <i class="bi bi-arrow-right-circle"></i>

                        Abrir

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-4 mb-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <i class="bi bi-fire display-3 text-warning"></i>

                    <h4 class="mt-3">
                        Prioridades
                    </h4>

                    <p class="text-muted">
                        Configure las prioridades para las incidencias.
                    </p>

                </div>

                <div class="card-footer bg-white border-0 text-center mb-3">

                    <a asp-controller="Prioridad"
                       asp-action="Index"
                       class="btn btn-warning text-dark">

                        <i class="bi bi-arrow-right-circle"></i>

                        Abrir

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-4 mb-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <i class="bi bi-check-circle-fill display-3 text-success"></i>

                    <h4 class="mt-3">
                        Estados
                    </h4>

                    <p class="text-muted">
                        Administre los estados disponibles del sistema.
                    </p>

                </div>

                <div class="card-footer bg-white border-0 text-center mb-3">

                    <a asp-controller="Estado"
                       asp-action="Index"
                       class="btn btn-success">

                        <i class="bi bi-arrow-right-circle"></i>

                        Abrir

                    </a>

                </div>

            </div>

        </div>





    </div>

</div>