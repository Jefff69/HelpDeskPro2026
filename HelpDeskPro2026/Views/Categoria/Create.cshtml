@model HelpDeskPro2026.Models.Categoria

@{
    ViewData["Title"] = "Crear Categoría";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-tags-fill text-warning"></i>

                Crear Categoría

            </h2>

            <p class="text-muted mb-0">

                Registre una nueva categoría en la plataforma.

            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>

            Volver

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-body">

                    <form asp-action="Create">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-3">

                            <label asp-for="Nombre"
                                   class="form-label fw-semibold">

                                Nombre de la Categoría

                            </label>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   placeholder="Ingrese el nombre de la categoría" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="form-check mb-4">

                            <input asp-for="Activo"
                                   class="form-check-input" />

                            <label asp-for="Activo"
                                   class="form-check-label">

                                Categoría activa

                            </label>

                            <span asp-validation-for="Activo"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-warning text-dark">

                                <i class="bi bi-check-circle-fill"></i>

                                Crear Categoría

                            </button>


                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-left"></i>

                                Volver

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}