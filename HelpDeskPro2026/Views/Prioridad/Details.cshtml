@model HelpDeskPro2026.Models.Prioridad

@{
    ViewData["Title"] = "Detalle de Prioridad";

    string colorVisual = Model.Color?.ToLower() switch
    {
        "rojo" => "#dc3545",
        "red" => "#dc3545",

        "amarillo" => "#ffc107",
        "yellow" => "#ffc107",

        "verde" => "#198754",
        "green" => "#198754",

        "naranja" => "#fd7e14",
        "orange" => "#fd7e14",

        "#dc3545" => "#dc3545",
        "#ffc107" => "#ffc107",
        "#198754" => "#198754",
        "#28a745" => "#198754",
        "#fd7e14" => "#fd7e14",

        _ => "#6c757d"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">
            <i class="bi bi-eye-fill text-info"></i>
            Detalle de Prioridad
        </h2>

        <p class="text-muted mb-0">
            Información de la prioridad seleccionada.
        </p>
    </div>

    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Volver
        </a>
    </div>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-3">
                Nombre de la Prioridad
            </dt>

            <dd class="col-sm-9">
                <strong>
                    @Model.Nombre
                </strong>
            </dd>


            <dt class="col-sm-3">
                Color
            </dt>

            <dd class="col-sm-9">

                <span style="
                    display:inline-block;
                    width:32px;
                    height:32px;
                    background-color:@colorVisual;
                    border-radius:6px;
                    border:1px solid #ccc;
                    vertical-align:middle;">
                </span>

            </dd>


            <dt class="col-sm-3">
                Estado
            </dt>

            <dd class="col-sm-9">

                @if (Model.Activo)
                {
                    <span class="badge bg-success">
                        Activa
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Inactiva
                    </span>
                }

            </dd>

        </dl>

    </div>

</div>

<div class="mt-3">

    <a asp-action="Edit"
       asp-route-id="@Model?.Id"
       class="btn btn-warning">

        <i class="bi bi-pencil-fill"></i>
        Editar

    </a>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>
        Volver

    </a>

</div>