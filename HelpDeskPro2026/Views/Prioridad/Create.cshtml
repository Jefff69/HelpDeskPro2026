@model HelpDeskPro2026.Models.Prioridad

@{
    ViewData["Title"] = "Nueva Prioridad";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold">

            <i class="bi bi-fire text-warning"></i>

            Nueva Prioridad

        </h2>

        <p class="text-muted mb-0">

            Registre una nueva prioridad para las incidencias.

        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>

        Volver

    </a>

</div>


<div class="card shadow-sm mx-auto" style="max-width: 700px;">

    <div class="card-body">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- Nombre -->

            <div class="mb-3">

                <label asp-for="Nombre"
                       class="form-label">

                    Nombre de la Prioridad

                </label>

                <input asp-for="Nombre"
                       class="form-control"
                       placeholder="Ej. Urgente" />

                <span asp-validation-for="Nombre"
                      class="text-danger">
                </span>

            </div>


            <!-- Color -->

            <div class="mb-3">

                <label asp-for="Color"
                       class="form-label">

                    Nivel de Prioridad

                </label>

                <select asp-for="Color"
                        class="form-select">

                    <option value="">Seleccione una prioridad...</option>

                    <option value="#28a745">
                        🟢 Baja
                    </option>

                    <option value="#ffc107">
                        🟡 Media
                    </option>

                    <option value="#fd7e14">
                        🟠 Alta
                    </option>

                    <option value="#dc3545">
                        🔴 Urgente
                    </option>

                </select>

                <span asp-validation-for="Color"
                      class="text-danger">
                </span>

            </div>


            <!-- Estado -->

            <div class="form-check mb-4">

                <input asp-for="Activo"
                       class="form-check-input" />

                <label asp-for="Activo"
                       class="form-check-label">

                    Prioridad activa

                </label>

            </div>


            <!-- Botones -->

            <button type="submit"
                    class="btn btn-warning text-dark">

                <i class="bi bi-check-circle-fill"></i>

                Crear Prioridad

            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                Cancelar

            </a>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}