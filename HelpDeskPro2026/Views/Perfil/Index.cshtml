@model HelpDeskPro2026.ViewModels.PerfilViewModel

@{
    ViewData["Title"] = "Mi Perfil";
}

<h2>Mi Perfil</h2>

<form asp-action="Index"
      method="post"
      enctype="multipart/form-data">

    <div class="card">

        <div class="card-body">

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input class="form-control" value="@Model.Nombre" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Apellidos</label>
            <input class="form-control" value="@Model.Apellidos" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Correo</label>
            <input class="form-control" value="@Model.Correo" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Rol</label>
            <input class="form-control" value="@Model.Rol" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Estado</label>
            <input class="form-control"
                   value="@(Model.Activo ? "Activo" : "Inactivo")"
                   readonly />
        </div>

                <div class="mb-3">

                    <label class="form-label">
                        Fotografía
                    </label>

                @if (!string.IsNullOrEmpty(Model.FotoUrl))
                {
                    <div class="mb-3">
                        <img src="@Model.FotoUrl"
                             width="180"
                             class="img-thumbnail rounded" />
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary">
                        El usuario aún no tiene una fotografía de perfil.
                    </div>
                }

                    <input asp-for="Foto"
                           class="form-control"
                           type="file" />

                </div>

                <button class="btn btn-primary">
                    Guardar Cambios
                </button>
            </div>

        </form>

    </div>

</div>