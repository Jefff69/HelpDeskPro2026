@model HelpDeskPro2026.Models.Usuario

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-danger">

                <i class="bi bi-person-x-fill"></i>

                Eliminar Usuario

            </h2>

            <p class="text-muted mb-0">

                Revise la información antes de confirmar la eliminación.

            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>

            Volver

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-danger">

                <div class="card-body">


                    <div class="alert alert-warning">

                        <i class="bi bi-exclamation-triangle-fill"></i>

                        <strong>Atención:</strong>

                        Esta acción eliminará el usuario del sistema.

                        Verifique la información antes de continuar.

                    </div>


                    <div class="text-center mb-4">

                        @if (!string.IsNullOrEmpty(Model.FotoUrl))
                        {
                            <img src="@Model.FotoUrl"
                                 width="110"
                                 height="110"
                                 class="rounded-circle shadow-sm"
                                 style="object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center"
                                 style="width:110px; height:110px;">

                                <i class="bi bi-person-fill text-secondary"
                                   style="font-size: 3.5rem;"></i>

                            </div>
                        }

                        <h3 class="mt-3 mb-1">

                            @Model.Nombre @Model.Apellidos

                        </h3>

                        <p class="text-muted">

                            @Model.Correo

                        </p>

                    </div>


                    <hr />


                    <div class="row mb-3">

                        <div class="col-md-6">

                            <strong>

                                <i class="bi bi-person-fill text-primary"></i>

                                Nombre

                            </strong>

                            <div class="text-muted">

                                @Model.Nombre

                            </div>

                        </div>


                        <div class="col-md-6">

                            <strong>

                                <i class="bi bi-person-lines-fill text-primary"></i>

                                Apellidos

                            </strong>

                            <div class="text-muted">

                                @Model.Apellidos

                            </div>

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-md-6">

                            <strong>

                                <i class="bi bi-envelope-fill text-primary"></i>

                                Correo

                            </strong>

                            <div class="text-muted">

                                @Model.Correo

                            </div>

                        </div>


                        <div class="col-md-6">

                            <strong>

                                <i class="bi bi-shield-fill-check text-primary"></i>

                                Rol

                            </strong>

                            <div class="text-muted">

                                @if (Model.Rol != null)
                                {
                                    @Model.Rol.Nombre
                                }
                                else
                                {
                                    <span>Sin rol asignado</span>
                                }

                            </div>

                        </div>

                    </div>


                    <div class="mb-4">

                        <strong>

                            <i class="bi bi-toggle-on text-primary"></i>

                            Estado

                        </strong>

                        <div class="mt-1">

                            @if (Model.Activo)
                            {
                                <span class="badge bg-success">

                                    Activo

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">

                                    Inactivo

                                </span>
                            }

                        </div>

                    </div>


                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-x-circle"></i>

                            Cancelar

                        </a>


                        <form asp-action="Delete"
                              method="post">

                            <input type="hidden"
                                   asp-for="Id" />

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-trash-fill"></i>

                                Eliminar Usuario

                            </button>

                        </form>

                    </div>


                </div>

            </div>

        </div>

    </div>

</div>