@model IEnumerable<HelpDeskPro2026.Models.Usuario>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold">

            <i class="bi bi-people-fill text-primary"></i>

            Gestión de Usuarios

        </h2>

        <p class="text-muted mb-0">

            Administre los usuarios registrados en la plataforma, sus roles y fotografías de perfil.

        </p>

    </div>

    <div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary me-2">

            <i class="bi bi-house-door-fill"></i>

            Inicio

        </a>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-person-plus-fill"></i>

            Nuevo Usuario

        </a>

    </div>

</div>

<div class="card shadow-sm">

    <div class="card-body">


        <table class="table table-hover table-striped align-middle">
    <thead class="table-dark">

        <tr>

            <th>Foto</th>

            <th>Nombre</th>

            <th>Correo</th>

            <th>Rol</th>

            <th>Estado</th>

            <th class="text-center">
                Acciones
            </th>

        </tr>

    </thead>
    <tbody>
@foreach (var item in Model) {
            <tr>

                <td>
                    @if (!string.IsNullOrEmpty(item.FotoUrl))
                    {
                        <img src="@item.FotoUrl"
                             width="45"
                             height="45"
                             class="rounded-circle"
                             style="object-fit:cover;" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/45"
                             width="45"
                             height="45"
                             class="rounded-circle" />
                    }
                </td>

                <td>
                    @item.NombreCompleto
                </td>

                <td>
                    @item.Correo
                </td>

                <td>
                    @(item.Rol?.Nombre ?? "-")
                </td>

                <td>
                    @if (item.Activo)
                    {
                        <span class="badge bg-success">
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactivo
                        </span>
                    }
                </td>

                <td class="text-center">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm"
                               title="Editar usuario">

                                <i class="bi bi-pencil-fill"></i>

                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm text-white"
                               title="Ver detalles">

                                <i class="bi bi-eye-fill"></i>

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm"
                               title="Eliminar usuario">

                                <i class="bi bi-trash-fill"></i>

                            </a>

                </td>

            </tr>
}
    </tbody>
</table>
    </div>

</div>