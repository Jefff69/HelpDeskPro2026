@model HelpDeskPro2026.Models.Riesgo

@{
    ViewData["Title"] = "Crear Riesgo";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-exclamation-triangle-fill text-danger"></i>

                Crear Riesgo

            </h2>

            <p class="text-muted mb-0">

                Registre un nuevo nivel de riesgo en la plataforma.

            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>

            Volver

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-body">

                    <form asp-action="Create">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-3">

                            <label asp-for="Nombre"
                                   class="form-label fw-semibold">

                                Nombre del Riesgo

                            </label>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   placeholder="Ej. Bajo, Medio, Alto o Urgente" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Color"
                                   class="form-label fw-semibold">

                                Nivel de Riesgo

                            </label>

                            <select asp-for="Color"
                                    class="form-select">

                                <option value="">Seleccione un nivel...</option>

                                <option value="#198754">🟢 Bajo</option>

                                <option value="#ffc107">🟡 Medio</option>

                                <option value="#fd7e14">🟠 Alto</option>

                                <option value="#dc3545">🔴 Crítico</option>

                            </select>

                            <span asp-validation-for="Color"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="form-check mb-4">

                            <input asp-for="Activo"
                                   class="form-check-input" />

                            <label asp-for="Activo"
                                   class="form-check-label">

                                Riesgo activo

                            </label>

                            <span asp-validation-for="Activo"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-check-circle-fill"></i>

                                Crear Riesgo

                            </button>


                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-left"></i>

                                Volver

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}