@model IEnumerable<HelpDeskPro2026.Models.Riesgo>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold">

            <i class="bi bi-exclamation-triangle-fill text-danger"></i>

            Gestión de Riesgos

        </h2>

        <p class="text-muted mb-0">

            Administre los niveles de riesgo utilizados en la plataforma.

        </p>

    </div>

    <div>

        <a asp-controller="Catalogo"
           asp-action="Index"
           class="btn btn-outline-secondary me-2">

            <i class="bi bi-arrow-left"></i>

            Volver

        </a>
        

        <a asp-action="Create"
           class="btn btn-danger">

            <i class="bi bi-plus-circle-fill"></i>

            Nuevo Riesgo

        </a>

    </div>

</div>



<div class="card shadow-sm">

    <div class="card-body">

        <table class="table table-hover table-striped align-middle">
            <thead class="table-dark">

                <tr>

                    <th>Color</th>

                    <th>Nombre</th>

                    <th>Estado</th>

                    <th class="text-center">
                        Acciones
                    </th>

                </tr>

            </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                        <td>
                            @{
                                string colorVisual = item.Color?.ToLower() switch
                                {
                                    "#dc3545" => "#dc3545",
                                    "rojo" => "#dc3545",
                                    "red" => "#dc3545",

                                    "#ffc107" => "#ffc107",
                                    "amarillo" => "#ffc107",
                                    "yellow" => "#ffc107",

                                    "#28a745" => "#28a745",
                                    "#198754" => "#198754",
                                    "verde" => "#28a745",
                                    "green" => "#28a745",

                                    "#fd7e14" => "#fd7e14",
                                    "naranja" => "#fd7e14",
                                    "orange" => "#fd7e14",

                                    _ => "#6c757d"
                                };

                                string nombreNivel = item.Color?.ToLower() switch
                                {
                                    "#dc3545" => "Crítico",
                                    "rojo" => "Crítico",
                                    "red" => "Crítico",

                                    "#ffc107" => "Medio",
                                    "amarillo" => "Medio",
                                    "yellow" => "Medio",

                                    "#28a745" => "Bajo",
                                    "#198754" => "Bajo",
                                    "verde" => "Bajo",
                                    "green" => "Bajo",

                                    "#fd7e14" => "Alto",
                                    "naranja" => "Alto",
                                    "orange" => "Alto",

                                    _ => "No definido"
                                };

                                string textoColor = nombreNivel == "Medio" ? "#000" : "#fff";
                            }

                            <span class="badge"
                                  style="background-color:@colorVisual; color:@textoColor;">
                                @nombreNivel
                            </span>
                        </td>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                            @if (item.Activo)
                            {
                                <span class="badge bg-success">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactivo
                                </span>
                            }
            </td>
                        <td class="text-center">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm"
                               title="Editar riesgo">

                                <i class="bi bi-pencil-fill"></i>

                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm text-white"
                               title="Ver detalles">

                                <i class="bi bi-eye-fill"></i>

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm"
                               title="Eliminar riesgo">

                                <i class="bi bi-trash-fill"></i>

                            </a>

                        </td>
        </tr>
}
    </tbody>
</table>
    </div>

</div>