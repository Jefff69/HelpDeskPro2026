@model HelpDeskPro2026.Models.ViewModels.TicketCreateViewModel
@{
    ViewData["Title"] = "Nuevo Ticket";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3"><i class="bi bi-plus-circle me-2"></i>Nuevo Ticket</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken() 

                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="SistemaId" class="form-label fw-semibold">Sistema *</label>
                        <select asp-for="SistemaId" asp-items="Model.Sistemas" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoriaId" class="form-label fw-semibold">Categoría *</label>
                        <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RiesgoId" class="form-label fw-semibold">Riesgo *</label>
                        <select asp-for="RiesgoId" asp-items="Model.Riesgos" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PrioridadId" class="form-label fw-semibold">Prioridad *</label>
                        <select asp-for="PrioridadId" asp-items="Model.Prioridades" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Asunto" class="form-label fw-semibold">Asunto *</label>
                    <input asp-for="Asunto" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-semibold">Descripción *</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" required></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Justificacion" class="form-label">Justificación</label>
                    <textarea asp-for="Justificacion" class="form-control" rows="2"></textarea>
                </div>

                
                <div class="mb-4">
                    <label asp-for="ArchivosAdjuntos" class="form-label fw-semibold">Archivos adjuntos (imágenes, PDF, Word)</label>
                    <input type="file" name="ArchivosAdjuntos" multiple class="form-control" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx" />
                    <div class="form-text">Puedes seleccionar varios archivos a la vez</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Guardar Ticket
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>