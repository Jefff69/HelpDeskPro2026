@model HelpDeskPro2026.Models.ViewModels.TicketFilterViewModel

@{
    ViewData["Title"] = "Tickets";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">
                <i class="bi bi-ticket-detailed-fill text-primary"></i>
                Tickets
            </h1>

            <p class="text-muted mb-0">
                Administración y seguimiento de incidencias.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Nuevo Ticket
        </a>

    </div>


    <!-- FILTROS -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <div class="col-md-5">

                        <label asp-for="SistemaId" class="form-label fw-semibold">
                            Sistema
                        </label>

                        <select asp-for="SistemaId"
                                asp-items="Model.Sistemas"
                                class="form-select">

                            <option value="">
                                -- Todos los Sistemas --
                            </option>

                        </select>

                    </div>


                    <div class="col-md-5">

                        <label asp-for="EstadoId" class="form-label fw-semibold">
                            Estado
                        </label>

                        <select asp-for="EstadoId"
                                asp-items="Model.Estados"
                                class="form-select">

                            <option value="">
                                -- Todos los Estados --
                            </option>

                        </select>

                    </div>


                    <div class="col-md-2 d-flex align-items-end">

                        <button type="submit" class="btn btn-primary w-100">

                            <i class="bi bi-funnel"></i>
                            Filtrar

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- TABLA -->
    @if (Model.Tickets != null && Model.Tickets.Any())
    {
        <div class="card shadow">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th>Código</th>

                                <th>Asunto</th>

                                <th>Sistema</th>

                                <th>Prioridad</th>

                                <th>Riesgo</th>

                                <th>Estado</th>

                                <th>Solicitante</th>

                                <th>Técnico</th>

                                <th>Fecha</th>

                                <th class="text-center">Acciones</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var ticket in Model.Tickets)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @ticket.CodigoTicket
                                        </strong>
                                    </td>


                                    <td>
                                        @ticket.Asunto
                                    </td>


                                    <td>
                                        @ticket.NombreSistema
                                    </td>


                                    <td>
                                        <span class="badge bg-secondary">
                                            @ticket.NombrePrioridad
                                        </span>
                                    </td>


                                    <td>

                                        <span class="badge"
                                              style="background-color:@ticket.ColorRiesgo">

                                            @ticket.NombreRiesgo

                                        </span>

                                    </td>


                                    <td>
                                        <span class="badge bg-primary">
                                            @ticket.NombreEstado
                                        </span>
                                    </td>


                                    <td>
                                        @ticket.NombreSolicitante
                                    </td>


                                    <td>
                                        @ticket.NombreTecnico
                                    </td>


                                    <td>
                                        @ticket.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>


                                    <td class="text-center">

                                        <a asp-action="Ver"
                                           asp-route-id="@ticket.Id"
                                           class="btn btn-sm btn-info text-white me-1">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        @if (User.IsInRole("Super Usuario") ||
                                            User.IsInRole("Administrador") ||
                                            User.IsInRole("Técnico"))
                                        {
                                            <a asp-action="Editar"
                                               asp-route-id="@ticket.Id"
                                               class="btn btn-sm btn-warning">

                                                <i class="bi bi-pencil"></i>

                                            </a>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-ticket-perforated display-1 text-muted"></i>

                <h4 class="mt-3">
                    No hay tickets registrados
                </h4>

                <p class="text-muted">
                    Cuando se cree una incidencia, aparecerá aquí.
                </p>

                <a asp-action="Create" class="btn btn-primary">

                    <i class="bi bi-plus-circle"></i>
                    Crear primer ticket

                </a>

            </div>

        </div>
    }

</div>