@model HelpDeskPro2026.Models.ViewModels.TicketDetailViewModel

@{
    ViewData["Title"] = $"Detalle del Ticket {Model.CodigoTicket}";
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">
                <i class="bi bi-ticket-detailed-fill text-primary"></i>
                Detalle del Ticket
            </h1>

            <p class="text-muted mb-0">
                Información y seguimiento de la incidencia.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver
        </a>

    </div>


    <!-- INFORMACIÓN PRINCIPAL DEL TICKET -->
    <div class="card shadow mb-4">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">

            <div>
                <strong>@Model.CodigoTicket</strong>
                <span class="mx-2">|</span>
                @Model.Asunto
            </div>

            <span class="badge bg-light text-dark">
                @Model.Estado
            </span>

        </div>


        <div class="card-body p-4">

            <div class="row g-4">

                <!-- COLUMNA IZQUIERDA -->
                <div class="col-md-6">

                    <p class="mb-2">
                        <strong>Sistema:</strong>
                        @Model.Sistema
                    </p>

                    <p class="mb-2">
                        <strong>Categoría:</strong>
                        @Model.Categoria
                    </p>

                    <p class="mb-2">
                        <strong>Prioridad:</strong>
                        @Model.Prioridad
                    </p>

                    <p class="mb-2">
                        <strong>Riesgo:</strong>

                        <span class="badge"
                              style="background-color:@Model.ColorRiesgo">
                            @Model.Riesgo
                        </span>
                    </p>

                </div>


                <!-- COLUMNA DERECHA -->
                <div class="col-md-6">

                    <p class="mb-2">
                        <strong>Solicitante:</strong>
                        @Model.Solicitante
                    </p>

                    <p class="mb-2">
                        <strong>Técnico asignado:</strong>
                        @(Model.TecnicoAsignado ?? "Sin asignar")
                    </p>

                    <p class="mb-2">
                        <strong>Fecha de creación:</strong>
                        @Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </p>

                </div>


                <!-- DESCRIPCIÓN -->
                <div class="col-12">

                    <hr />

                    <h6 class="fw-bold text-uppercase text-muted">
                        Descripción
                    </h6>

                    <div class="bg-light rounded p-3">
                        @Model.Descripcion
                    </div>

                </div>


                <!-- JUSTIFICACIÓN -->
                @if (!string.IsNullOrWhiteSpace(Model.Justificacion))
                {
                    <div class="col-12">

                        <h6 class="fw-bold text-uppercase text-muted">
                            Justificación
                        </h6>

                        <div class="bg-light rounded p-3">
                            @Model.Justificacion
                        </div>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- ARCHIVOS ADJUNTOS -->
    @if (Model.Adjuntos != null && Model.Adjuntos.Any())
    {
        <div class="card shadow mb-4">

            <div class="card-header bg-light">

                <h5 class="mb-0">
                    <i class="bi bi-paperclip me-2"></i>
                    Archivos adjuntos
                </h5>

            </div>


            <div class="card-body">

                @foreach (var adjunto in Model.Adjuntos)
                {
                    <div class="d-flex align-items-center mb-2">

                        <i class="bi bi-file-earmark me-2 text-primary"></i>

                        <a href="@adjunto.UrlArchivo"
                           target="_blank"
                           class="text-decoration-none">

                            @adjunto.NombreArchivo

                        </a>

                    </div>
                }

            </div>

        </div>
    }


    <!-- COMENTARIOS -->
    <div class="card shadow">

        <div class="card-header bg-light">

            <h5 class="mb-0">

                <i class="bi bi-chat-dots me-2"></i>

                Comentarios

                <span class="badge bg-secondary">
                    @Model.Comentarios.Count
                </span>

            </h5>

        </div>


        <div class="card-body">


            <!-- LISTA DE COMENTARIOS -->
            @if (Model.Comentarios != null && Model.Comentarios.Any())
            {
                foreach (var comentario in Model.Comentarios.OrderBy(c => c.Fecha))
                {
                    <div class="d-flex gap-3 mb-3 pb-3 border-bottom">

                        <!-- FOTO -->
                        <img src="@(string.IsNullOrWhiteSpace(comentario.UrlFotoUsuario)
                                                              ? "/img/default-user.png"
                                                              : comentario.UrlFotoUsuario)"
                             class="rounded-circle flex-shrink-0"
                             style="width:40px;height:40px;object-fit:cover;border:1px solid #dee2e6;"
                             alt="Foto de @comentario.NombreUsuario" />


                        <!-- CONTENIDO -->
                        <div class="flex-grow-1">

                            <div class="d-flex justify-content-between align-items-center">

                                <strong>
                                    @comentario.NombreUsuario
                                </strong>

                                <span class="text-muted small">
                                    @comentario.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </span>

                            </div>

                            <p class="mb-0 mt-1 text-muted">
                                @comentario.Texto
                            </p>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4">

                    <i class="bi bi-chat-square-text display-6"></i>

                    <p class="mt-2 mb-0">
                        Todavía no hay comentarios.
                    </p>

                </div>
            }


            <!-- AGREGAR COMENTARIO -->
            <div class="mt-4">

                <h6 class="fw-bold">
                    Agregar comentario
                </h6>

                <form asp-action="AgregarComentario"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <textarea name="TextoComentario"
                              class="form-control mb-2"
                              rows="3"
                              placeholder="Escriba su comentario..."
                              required></textarea>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-send me-1"></i>
                        Enviar comentario

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>