@model HelpDeskPro2026.Models.Estado

@{
    ViewData["Title"] = "Detalle del Estado";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold">

            <i class="bi bi-info-circle-fill text-info"></i>

            Detalle del Estado

        </h2>

        <p class="text-muted mb-0">

            Información del estado seleccionado.

        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>

        Volver

    </a>

</div>


<div class="card shadow-sm mx-auto" style="max-width: 730px;">

    <div class="card-body">

        <dl class="row mb-0">

            <!-- Nombre -->

            <dt class="col-sm-4">
                Estado
            </dt>

            <dd class="col-sm-8">

                @if (Model.Nombre == "Nuevo")
                {
                    <span class="badge bg-primary">
                        🆕 Nuevo
                    </span>
                }
                else if (Model.Nombre == "En revisión")
                {
                    <span class="badge bg-info text-dark">
                        🔍 En revisión
                    </span>
                }
                else if (Model.Nombre == "En proceso")
                {
                    <span class="badge bg-warning text-dark">
                        🔧 En proceso
                    </span>
                }
                else if (Model.Nombre == "Resuelto")
                {
                    <span class="badge bg-success">
                        ✅ Resuelto
                    </span>
                }
                else if (Model.Nombre == "Cerrado")
                {
                    <span class="badge bg-secondary">
                        🔒 Cerrado
                    </span>
                }
                else
                {
                    @Html.DisplayFor(model => model.Nombre)
                }

            </dd>


            <!-- Estado activo -->

            <dt class="col-sm-4">
                Estado en el sistema
            </dt>

            <dd class="col-sm-8">

                @if (Model.Activo)
                {
                    <span class="badge bg-success">
                        Activo
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Inactivo
                    </span>
                }

            </dd>

        </dl>


        <hr />

        <div class="mt-3">

            <a asp-action="Edit"
               asp-route-id="@Model?.Id"
               class="btn btn-warning">

                <i class="bi bi-pencil-fill"></i>

                Editar

            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>

                Volver a Estados

            </a>

        </div>

    </div>

</div>