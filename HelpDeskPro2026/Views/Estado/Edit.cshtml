@model HelpDeskPro2026.Models.Estado

@{
    ViewData["Title"] = "Editar Estado";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold">

            <i class="bi bi-pencil-square text-warning"></i>

            Editar Estado

        </h2>

        <p class="text-muted mb-0">

            Modifique la información del estado seleccionado.

        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>

        Volver

    </a>

</div>


<div class="card shadow-sm mx-auto" style="max-width: 730px;">

    <div class="card-body">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <input type="hidden" asp-for="Id" />


            <!-- Nombre del estado -->

            <div class="mb-3">

                <label asp-for="Nombre"
                       class="form-label fw-semibold">

                    Nombre del estado

                </label>

                <input asp-for="Nombre"
                       class="form-control"
                       placeholder="Ejemplo: Esperando información" />

                <span asp-validation-for="Nombre"
                      class="text-danger">
                </span>

            </div>


            <!-- Estado activo -->

            <div class="form-check mb-4">

                <input asp-for="Activo"
                       class="form-check-input" />

                <label asp-for="Activo"
                       class="form-check-label">

                    Estado activo

                </label>

            </div>


            <!-- Botones -->

            <button type="submit"
                    class="btn btn-warning">

                <i class="bi bi-check-circle-fill"></i>

                Guardar Cambios

            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-x-circle"></i>

                Cancelar

            </a>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}