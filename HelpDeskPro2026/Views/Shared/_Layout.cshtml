<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HelpDeskPro2026</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HelpDeskPro2026.styles.css" asp-append-version="true" />
</head>
<body>

    <header class="fixed-top">

        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm"
             style="background-color:#1f3a5f;">

            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-tools"></i>

                    HelpDesk Pro

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMain">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="navbarMain">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door-fill"></i>
                                Inicio
                            </a>
                        </li>

                        @* Tickets: disponible para todos los usuarios autenticados *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Tickets"
                                   asp-action="Index">

                                    <i class="bi bi-ticket-detailed-fill"></i>
                                    Tickets

                                </a>
                            </li>
                        }


                        @* Catálogos: solo roles administrativos/técnicos *@
                        @if (User.IsInRole("Super Usuario") ||
                            User.IsInRole("Administrador") ||
                            User.IsInRole("Técnico"))
                        {
                            <li class="nav-item">

                                <a class="nav-link text-white"
                                   asp-controller="Catalogo"
                                   asp-action="Index">

                                    <i class="bi bi-folder-fill"></i>
                                    Catálogos

                                </a>

                            </li>
                        }


                        @* Usuarios: solo Super Usuario y Administrador *@
                        @if (User.IsInRole("Super Usuario") ||
                            User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">

                                <a class="nav-link text-white"
                                   asp-controller="Usuario"
                                   asp-action="Index">

                                    <i class="bi bi-people-fill"></i>
                                    Usuarios

                                </a>

                            </li>
                        }


                    </ul>

                    <ul class="navbar-nav">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <partial name="_UserMenu" />
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Iniciar sesión
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <div class="container mt-4">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        <main role="main">

            @RenderBody()

        </main>

    </div>

    <footer class="border-top footer text-muted mt-5">

        <div class="container">

            &copy; 2026 - HelpDeskPro2026

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>